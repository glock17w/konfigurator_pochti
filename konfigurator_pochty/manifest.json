{
  "manifest_version": 3,
  "name": "Конфигуратор почты",
  "version": "1.2",
  "description": "Цветные метки Работа / Личное / Рассылки и предупреждение о подозрительных письмах в Яндекс Почте и Gmail",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://mail.yandex.ru/*", "https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
